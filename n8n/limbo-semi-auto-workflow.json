    {
      "parameters": {
        "jsCode": "// ===== Integrated 4-Layer Hybrid Model (Semi-Auto) =====\n// Layer 1: Fractional bankroll sizing (base 0.1% ~ 0.2% cap)\n// Layer 2: Streak-adaptive sizing (winning momentum / losing defense)\n// Layer 3: Drawdown regime control (Normal/Caution/Defense)\n// Layer 4: Session circuit breaker (TP/SL/max tries + 4-loss cooldown)\n\nconst TARGET_MULTIPLIER = 25;\nconst BASE_BET_PCT = 0.001;       // 0.1%\nconst MAX_BET_PCT = 0.002;        // 0.2% cap\nconst MIN_BET = 0.01;\n\nconst PROFIT_TARGET_PCT = 10;     // +10%\nconst STOP_LOSS_PCT = -7;         // -7%\nconst MAX_TRIES = 400;\nconst LOSS_STREAK_FOR_PAUSE = 4;\nconst COOLDOWN_MINUTES = 15;\n\nconst input = $json;\nconst balance = Number(input.balance);\nconst result = String(input.result || '').toLowerCase();\n\nconst runtime = input.runtime || {};\nconst betProvider = runtime.betProvider || 'generic_http';\nconst currency = runtime.currency || 'CAD';\nconst executionMode = runtime.mode || 'semi_auto';\nconst dryRun = Boolean(runtime.dryRun);\nconst authCode = runtime.authCode || '';\nconst apiKey = runtime.apiKey || '';\n\nif (!Number.isFinite(balance) || balance <= 0) {\n  throw new Error('balance는 0보다 큰 숫자여야 합니다.');\n}\nif (!['win', 'loss'].includes(result)) {\n  throw new Error('result는 \"win\" 또는 \"loss\" 여야 합니다.');\n}\n\nconst state = getWorkflowStaticData('global');\nif (!state.initialized) {\n  state.initialized = true;\n  state.startBalance = balance;\n  state.tries = 0;\n  state.streak = 0;         // +: win streak, -: loss streak\n  state.lossStreak = 0;\n  state.cooldownUntil = null;\n  state.history = [];       // rolling outcomes: 1=win,0=loss\n}\n\nstate.tries += 1;\n\nif (result === 'win') {\n  state.streak = state.streak > 0 ? state.streak + 1 : 1;\n  state.lossStreak = 0;\n  state.history.push(1);\n} else {\n  state.streak = state.streak < 0 ? state.streak - 1 : -1;\n  state.lossStreak += 1;\n  state.history.push(0);\n}\nif (state.history.length > 20) state.history = state.history.slice(-20);\n\nconst now = new Date();\nconst existingCooldown = state.cooldownUntil ? new Date(state.cooldownUntil) : null;\n\nconst pnl = balance - state.startBalance;\nconst pnlPct = (pnl / state.startBalance) * 100;\n\n// ---- Layer 3: drawdown regime ----\nlet regime = 'normal';\nlet regimeFactor = 1.0;\nif (pnlPct <= -4) {\n  regime = 'defense';\n  regimeFactor = 0.55;\n} else if (pnlPct <= -2) {\n  regime = 'caution';\n  regimeFactor = 0.75;\n}\n\n// ---- Layer 2: streak-adaptive factor ----\nlet streakFactor = 1.0;\nif (state.streak >= 2) {\n  streakFactor = Math.min(1.25, 1 + (state.streak - 1) * 0.05); // mild increase on momentum\n} else if (state.streak <= -2) {\n  streakFactor = Math.max(0.5, 1 - (Math.abs(state.streak) - 1) * 0.12); // stronger defense on losses\n}\n\n// recent hit rate factor (last up to 10)\nconst recent = state.history.slice(-10);\nconst recentHit = recent.length ? recent.reduce((a,b)=>a+b,0) / recent.length : 0.5;\nlet hitRateFactor = 1.0;\nif (recentHit < 0.4) hitRateFactor = 0.75;\nif (recentHit > 0.6) hitRateFactor = 1.1;\n\n// ---- Layer 1 + 2 + 3 integration ----\nconst baseBet = balance * BASE_BET_PCT;\nlet nextBetRaw = baseBet * streakFactor * regimeFactor * hitRateFactor;\nnextBetRaw = Math.min(nextBetRaw, balance * MAX_BET_PCT);\nconst nextBet = Math.max(MIN_BET, Number(nextBetRaw.toFixed(2)));\n\n// ---- Layer 4: circuit breaker ----\nlet action = 'BET';\nlet reason = 'hybrid_continue';\n\nif (state.tries >= MAX_TRIES) {\n  action = 'STOP';\n  reason = 'max_tries_reached';\n} else if (pnlPct >= PROFIT_TARGET_PCT) {\n  action = 'STOP';\n  reason = 'take_profit_reached';\n} else if (pnlPct <= STOP_LOSS_PCT) {\n  action = 'STOP';\n  reason = 'stop_loss_reached';\n} else if (existingCooldown && existingCooldown > now) {\n  action = 'PAUSE';\n  reason = 'cooldown_active';\n} else if (state.lossStreak >= LOSS_STREAK_FOR_PAUSE) {\n  const cooldown = new Date(now.getTime() + COOLDOWN_MINUTES * 60 * 1000);\n  state.cooldownUntil = cooldown.toISOString();\n  action = 'PAUSE';\n  reason = '4_losses_cooldown';\n  state.lossStreak = 0;\n} else {\n  state.cooldownUntil = null;\n}\n\nreturn [{\n  action,\n  reason,\n  executionMode,\n  betProvider,\n  currency,\n  dryRun,\n  authCode,\n  apiKey,\n  model: {\n    name: 'hybrid_4layer_profit_survival',\n    regime,\n    factors: {\n      streakFactor: Number(streakFactor.toFixed(3)),\n      regimeFactor: Number(regimeFactor.toFixed(3)),\n      hitRateFactor: Number(hitRateFactor.toFixed(3)),\n      recentHitRate: Number((recentHit * 100).toFixed(1))\n    }\n  },\n  next: {\n    bet: nextBet,\n    multiplier: TARGET_MULTIPLIER\n  },\n  pnl: Number(pnl.toFixed(2)),\n  pnlPct: Number(pnlPct.toFixed(2)),\n  streak: state.streak,\n  tries: state.tries,\n  cooldownUntil: state.cooldownUntil,\n  balance,\n  result,\n  timestamp: now.toISOString()\n}];"
      },
